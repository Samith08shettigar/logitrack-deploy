# Flask Environment Configuration
FLASK_CONFIG=production
SECRET_KEY=your-super-secret-key-change-me

# Database Configuration
# Leave commented out for default SQLite, or specify PostgreSQL / MySQL URI:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Email / SMTP Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notifications@logitrack-logistics.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=LogiTrack Notifications <notifications@logitrack-logistics.com>
